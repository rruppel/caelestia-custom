#!/usr/bin/env python3
"""CPU/RAM/NVIDIA GPU/VRAM/root filesystem usage percentages for Quickshell."""
import json
import shutil
import subprocess
import time


def cpu_counters():
    with open('/proc/stat', encoding='utf-8') as f:
        numbers = list(map(int, f.readline().split()[1:]))
    total = sum(numbers)
    idle = numbers[3] + numbers[4]
    return total, idle


def cpu_usage():
    total1, idle1 = cpu_counters()
    time.sleep(0.25)
    total2, idle2 = cpu_counters()
    return round(100 * (1 - (idle2 - idle1) / max(1, total2 - total1)), 1)


def ram_usage():
    data = {}
    with open('/proc/meminfo', encoding='utf-8') as f:
        for line in f:
            key, value = line.split(':', 1)
            data[key] = int(value.strip().split()[0])
    return round(100 * (1 - data['MemAvailable'] / data['MemTotal']), 1)


def disk_usage():
    """Percentage of total capacity used on the root filesystem (/)."""
    try:
        usage = shutil.disk_usage("/")
        return round(100 * usage.used / usage.total, 1) if usage.total else None
    except OSError:
        return None


def gpu_usage():
    try:
        output = subprocess.check_output(
            [
                'nvidia-smi',
                '--query-gpu=utilization.gpu,memory.used,memory.total',
                '--format=csv,noheader,nounits',
            ], text=True, timeout=3, stderr=subprocess.DEVNULL
        )
        # First GPU; can be extended to multiple GPUs later.
        utilization, used, total = map(float, output.splitlines()[0].split(','))
        return utilization, round(100 * used / total, 1) if total else None
    except (OSError, subprocess.SubprocessError, ValueError, IndexError):
        return None, None


if __name__ == '__main__':
    gpu, vram = gpu_usage()
    print(json.dumps({
        'cpu': cpu_usage(),
        'ram': ram_usage(),
        'gpu': gpu,
        'vram': vram,
        'disk': disk_usage(),
    }, separators=(',', ':')))
